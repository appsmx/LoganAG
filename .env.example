# LoganAG — variables de entorno (copiar a .env y completar)

# Base de datos PostgreSQL (Neon en producción) — DEC-007
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Proxy LLM centralizado de LOGAN OS — DEC-003
# LoganAG NO usa llaves de IA propias. Toda la IA pasa por este proxy.
LOGAN_LLM_URL="https://logancorp.vercel.app/api/llm"
LOGAN_LLM_SECRET="<secreto-bearer-para-consumir-el-proxy-de-logan-os>"
