# LoganAG — variables de entorno (copiar a .env y completar)

# Base de datos PostgreSQL (Neon en producción) — DEC-007
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Proxy LLM centralizado de LOGAN OS — DEC-003
# LoganAG NO usa llaves de IA propias. Toda la IA pasa por este proxy.
# LOGAN_LLM_URL: endpoint del proxy de LOGAN OS (appsmx/logan-app), activo en
#   loganos.com. Dominio canónico (responde 200 directo, sin redirect): www.loganos.com
# LOGAN_LLM_SECRET: NO se crea nuevo — es el valor que ya existe en el Vercel de
#   LOGAN OS. Se copia a este .env (local) y al Vercel de LoganAG (producción).
LOGAN_LLM_URL="https://www.loganos.com/api/llm"
LOGAN_LLM_SECRET="<copiar-del-vercel-de-logan-os>"

# Autenticación por enlace mágico (DEC-010) + correo vía Brevo (estándar LOGAN)
AUTH_SECRET="<cadena-larga-aleatoria-para-firmar-sesiones>"
APP_URL="http://localhost:3000"
BREVO_API_KEY="<api-key-de-brevo>"
MAIL_FROM="LoganAG <no-reply@loganag.local>"

# Carga de fotos vía Cloudinary (opcional; sin esto se puede pegar una URL)
CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"

# Panel de administración de feedback: correo autorizado a ver /admin/feedback
ADMIN_EMAIL="<tu-correo-de-admin>"
